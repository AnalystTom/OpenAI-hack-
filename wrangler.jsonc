{
  "name": "dots-live-room",
  "main": "server/live-room.mjs",
  "compatibility_date": "2026-10-06",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/live/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "LiveRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }],
  "vars": { "ALLOWED_ORIGIN": "https://dots-office.pages.dev" }
}
